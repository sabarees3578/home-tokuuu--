// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows"]
}

// NOTE: Using SQLite for local development. 
// When deploying to EC2, change this provider to "postgresql" and update the DATABASE_URL in .env
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  name      String
  role      String   @default("admin")
  createdAt DateTime @default(now())
}



// ---------------------------------------------------------
// NEW TABLES REQUESTED BY USER
// ---------------------------------------------------------

model DeviceRegistry {
  id             Int       @id @default(autoincrement())
  deviceId       String    @unique
  deviceName     String?
  imei           String?
  mac            String?
  mqttUrl        String?
  mqttId         String?
  mqttKey        String?
  serial_number  String?
  firmware_version String?
  developerName  String?
  testerName     String?
  autoUpdate     Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relations to new tables
  ownership      DeviceOwnership?
  statuses       DeviceStatus[]
  eventLogs      DeviceEventLog[]
  otaUpdates     OtaUpdate[]
}

model DeviceOwnership {
  id               Int      @id @default(autoincrement())
  
  // Relation
  deviceId         String   @unique
  device           DeviceRegistry @relation(fields: [deviceId], references: [deviceId], onDelete: Cascade)

  customerName     String?
  customerAddress  String?
  registeredAt     DateTime @default(now())
  deviceName       String?
  customerNumber   String?  @unique
  adminNumber      String?
  deviceSimNumber  String?
  user1            String?
  user2            String?
  user3            String?
  user4            String?
  user5            String?

  simPlan          String?
  simPlanStartDate DateTime?
  simPlanEndDate   DateTime?
}

model DeviceStatus {
  id               Int      @id @default(autoincrement())

  // Relation
  deviceId         String
  device           DeviceRegistry @relation(fields: [deviceId], references: [deviceId], onDelete: Cascade)

  timestamp        DateTime @default(now())
  deviceStatus     String?  // Online, Offline, etc.
  productionMode   Boolean  @default(false)
  powerCutStatus   Boolean  @default(false)
  deviceBattery    Int?
  lastSeenAt       DateTime @default(now())
}

model DeviceEventLog {
  id               Int      @id @default(autoincrement())
  
  // Relation
  deviceId         String
  device           DeviceRegistry @relation(fields: [deviceId], references: [deviceId], onDelete: Cascade)

  topic            String
  log              String   // JSON string of the payload
  timestamp        DateTime @default(now())
}

// ---------------------------------------------------------
// OTA (Over-The-Air) — firmware updates via esp_ota_ops
// ---------------------------------------------------------

model FirmwareVersion {
  id          Int      @id @default(autoincrement())
  version     String
  description String?
  fileName    String
  filePath    String
  fileSize    Int      @default(0)
  window      String   @default("Auto") // partition window: Auto | OTA0 | OTA1
  md5         String?
  createdAt   DateTime @default(now())

  updates     OtaUpdate[]
}

model OtaUpdate {
  id        Int      @id @default(autoincrement())
  deviceId  String
  device    DeviceRegistry @relation(fields: [deviceId], references: [deviceId], onDelete: Cascade)
  versionId Int?
  version   FirmwareVersion? @relation(fields: [versionId], references: [id], onDelete: SetNull)

  method    String   @default("section") // auto | section
  status    String   @default("pending") // pending | pushing | downloading | flashing | success | failed
  progress  Int      @default(0)         // 0-100, reported by device
  message   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
